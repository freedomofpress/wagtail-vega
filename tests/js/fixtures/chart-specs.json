          "color": {"field": "agency", "type": "nominal", "legend": {"orient": "bottom"}, "scale": {"scheme": "tableau10"}},
          "tooltip": [{"field": "quarter"}, {"field": "thousands", "aggregate": "sum", "format": ",.1f"}],
          "opacity": {"condition": {"param": "pick", "value": 1}, "value": 0.3}
        },
        "config": {"axis": {"grid": false}}
      }
    },
