      "spec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
        "title": "Share of requests",
        "description": "Requests per quarter, by agency.",
        "width": "container",
        "height": 300,
        "autosize": {"type": "fit", "contains": "padding"},
        "data": {"name": "source"},
        "transform": [{"calculate": "datum.requests / 1000", "as": "thousands"}],
        "params": [{"name": "pick", "select": {"type": "point", "fields": ["agency"]}, "bind": "legend"}],
