[
  {
    "name": "bar with aggregate (as Voyager returns it)",
    "dataset": "source",
    "voyager": {
      "data": {"name": "source"},
      "mark": "bar",
      "encoding": {
        "x": {"field": "cat", "type": "nominal"},
        "y": {"aggregate": "sum", "field": "n", "type": "quantitative"}
      },
      "config": {"line": {"point": true}, "scale": {"useUnaggregatedDomain": true}}
    },
    "expected": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "data": {"name": "source"},
      "mark": "bar",
      "encoding": {
        "x": {"field": "cat", "type": "nominal"},
        "y": {"aggregate": "sum", "field": "n", "type": "quantitative"}
      },
      "config": {"line": {"point": true}, "scale": {"useUnaggregatedDomain": true}}
    }
  },
  {
    "name": "count loses Vega-Lite 2's field \"*\"",
    "dataset": "requests",
    "voyager": {
      "data": {"name": "source"},
      "mark": "bar",
      "encoding": {
        "y": {"field": "cat", "type": "nominal"},
        "x": {"aggregate": "count", "field": "*", "type": "quantitative"}
      }
    },
    "expected": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "data": {"name": "requests"},
      "mark": "bar",
      "encoding": {
        "y": {"field": "cat", "type": "nominal"},
        "x": {"aggregate": "count", "type": "quantitative"}
      }
    }
  },
  {
    "name": "time unit, empty scale dropped, inline data and old $schema replaced",
    "dataset": "weather",
    "voyager": {
      "$schema": "https://vega.github.io/schema/vega-lite/v2.json",
      "data": {"values": [{"d": "2020-01-01", "n": 1}]},
      "mark": "line",
      "encoding": {
        "x": {"timeUnit": "month", "field": "d", "type": "temporal", "scale": {}},
        "y": {"field": "n", "type": "quantitative"}
      }
    },
    "expected": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "data": {"name": "weather"},
      "mark": "line",
      "encoding": {
        "x": {"timeUnit": "month", "field": "d", "type": "temporal"},
        "y": {"field": "n", "type": "quantitative"}
      }
    }
  },
  {
    "name": "binning, colour, facet row and filters",
    "dataset": "source",
    "voyager": {
      "data": {"name": "source"},
      "mark": "point",
      "transform": [
        {"filter": {"field": "cat", "oneOf": ["A", "B"]}},
        {"filter": {"field": "n", "range": [0, 50]}},
        {"filter": {"timeUnit": "year", "field": "d", "range": [2019, 2020]}}
      ],
      "encoding": {
        "x": {"bin": true, "field": "n", "type": "quantitative"},
        "y": {"aggregate": "count", "field": "*", "type": "quantitative"},
        "color": {"field": "cat", "type": "nominal"},
        "row": {"field": "group", "type": "nominal"}
      }
    },
    "expected": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "data": {"name": "source"},
      "mark": "point",
      "transform": [
        {"filter": {"field": "cat", "oneOf": ["A", "B"]}},
        {"filter": {"field": "n", "range": [0, 50]}},
        {"filter": {"timeUnit": "year", "field": "d", "range": [2019, 2020]}}
      ],
      "encoding": {
        "x": {"bin": true, "field": "n", "type": "quantitative"},
        "y": {"aggregate": "count", "type": "quantitative"},
        "color": {"field": "cat", "type": "nominal"},
        "row": {"field": "group", "type": "nominal"}
      }
    }
  },
  {
    "name": "presentation settings kept from the field's spec, configs merged",
    "dataset": "source",
    "previous": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "title": "Requests by quarter",
      "description": "Grouped bars",
      "width": "container",
      "height": 300,
      "data": {"name": "source"},
      "mark": {"type": "bar", "tooltip": true},
      "encoding": {"x": {"field": "quarter", "type": "nominal", "title": null}},
      "config": {"axis": {"labelFontSize": 14}, "scale": {"bandPaddingInner": 0.2}}
    },
    "voyager": {
      "data": {"name": "source"},
      "mark": "tick",
      "encoding": {"x": {"field": "requests", "type": "quantitative"}},
      "config": {"line": {"point": true}, "scale": {"useUnaggregatedDomain": true}}
    },
    "expected": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "title": "Requests by quarter",
      "description": "Grouped bars",
      "width": "container",
      "height": 300,
      "data": {"name": "source"},
      "mark": "tick",
      "encoding": {"x": {"field": "requests", "type": "quantitative"}},
      "config": {
        "axis": {"labelFontSize": 14},
        "scale": {"bandPaddingInner": 0.2, "useUnaggregatedDomain": true},
        "line": {"point": true}
      }
    }
  },
  {
    "name": "nothing carried over from a Vega spec",
    "dataset": "source",
    "previous": {"$schema": "https://vega.github.io/schema/vega/v6.json", "width": 400, "marks": []},
    "voyager": {
      "data": {"name": "source"},
      "mark": "area",
      "encoding": {
        "x": {"field": "d", "type": "temporal", "timeUnit": "yearmonth"},
        "y": {"field": "n", "type": "quantitative", "aggregate": "mean"}
      }
    },
    "expected": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "data": {"name": "source"},
      "mark": "area",
      "encoding": {
        "x": {"field": "d", "type": "temporal", "timeUnit": "yearmonth"},
        "y": {"field": "n", "type": "quantitative", "aggregate": "mean"}
      }
    }
  }
]
