{
  "name": "wagtail-vega-js",
  "private": true,
  "description": "JS tooling for wagtail-vega: unit tests for the browser scripts (node:test, no dependencies), the reproducible CodeMirror bundle, and the vendored Vega libraries.",
  "scripts": {
    "test": "node --test tests/js/*.test.mjs",
    "build": "node scripts/build-codemirror.mjs && node scripts/vendor.mjs",
    "build:codemirror": "node scripts/build-codemirror.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
