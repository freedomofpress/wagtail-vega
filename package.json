{
  "name": "wagtail-vega-js",
  "private": true,
  "description": "JS tooling for wagtail-vega: unit tests for the browser scripts (node:test, no dependencies), the reproducible CodeMirror bundle, and the vendored Vega libraries and Vega Voyager (frozen at its 2018 dependencies; see scripts/vendor.mjs).",
  "scripts": {
    "test": "node --test tests/js/*.test.mjs",
    "build": "node scripts/build-codemirror.mjs && node scripts/vendor.mjs",
    "build:codemirror": "node scripts/build-codemirror.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "datavoyager": "2.0.0-alpha.24",
    "esbuild": "0.28.2",
    "font-awesome": "4.7.0",
    "hoist-non-react-statics": "2.5.5",
    "lodash": "4.17.21",
    "moment": "2.30.1",
    "object-unfreeze": "1.1.0",
    "prop-types": "15.8.1",
    "react": "15.7.0",
    "react-css-modules": "4.7.11",
    "react-dnd": "2.6.0",
    "react-dnd-html5-backend": "2.6.0",
    "react-dom": "15.7.0",
    "react-redux": "5.1.2",
    "react-tether": "0.5.7",
    "redux": "3.7.2",
    "redux-thunk": "2.4.2",
    "redux-undo": "1.0.0-beta9-9-6",
    "tether": "1.4.7",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0",
    "voyager-vega": "npm:vega@4.0.0",
    "voyager-vega-lite": "npm:vega-lite@2.4.0",
    "voyager-vega-tooltip": "npm:vega-tooltip@0.4.4"
  },
  "engines": {
    "node": ">=20"
  }
}
