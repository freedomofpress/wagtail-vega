{
  "name": "wagtail-vega-js",
  "private": true,
  "description": "JS tooling for wagtail-vega: unit tests for the browser scripts (node:test, no dependencies) and the reproducible CodeMirror bundle.",
  "scripts": {
    "test": "node --test tests/js/*.test.mjs",
    "build": "node scripts/build-codemirror.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
